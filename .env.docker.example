# Copy to .env.docker. Never commit the copy.
APP_NAME=VoltProcure
APP_ENV=production
APP_DEBUG=false
# Generate: docker compose -f docker-compose.prod.yml run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost:8090
# Production forces https URLs. Keep false while serving plain http on localhost;
# set true (and an https APP_URL) behind a TLS-terminating proxy.
APP_FORCE_HTTPS=false
APP_DEMO=true
APP_LOCALE=en

# Octane workers per container; "auto" uses one per CPU.
OCTANE_WORKERS=auto

# Cookie sessions and file cache keep SQLite writes for real data only.
SESSION_DRIVER=cookie
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_LEVEL=warning

MAIL_MAILER=log
